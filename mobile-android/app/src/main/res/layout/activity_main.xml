<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.22"
                android:text="@string/brand_kicker"
                android:textColor="@color/sakura"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="serif"
                android:letterSpacing="0.04"
                android:text="@string/setup_title"
                android:textColor="@color/ink"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/setup_subtitle"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_desc"
                android:textColor="@color/faint"
                android:textSize="11.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/scan_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary"
                android:drawableStart="@drawable/ic_camera"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="@string/scan_qr"
                android:textAllCaps="false"
                android:textColor="@color/button_ink"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1FFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/manual_label"
                    android:textColor="@color/faint"
                    android:textSize="9.5sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#1FFFFFFF" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/url_input"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="@string/url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/faint"
                android:textSize="12.5sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/connect_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ghost"
                android:drawableStart="@drawable/ic_link"
                android:drawablePadding="7dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="@string/connect"
                android:textAllCaps="false"
                android:textColor="@color/aqua"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/paste_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/paste"
                android:textColor="@color/lilac"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/status_ready"
                android:textColor="@color/muted"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/steps_title"
                    android:textColor="@color/sakura"
                    android:textSize="9.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="01"
                        android:textColor="@color/sakura"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/step_1"
                        android:textColor="@color/muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="02"
                        android:textColor="@color/sakura"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/step_2"
                        android:textColor="@color/muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="03"
                        android:textColor="@color/sakura"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/step_3"
                        android:textColor="@color/muted"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/back_local"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/back_local"
                android:textColor="@color/lilac"
                android:textSize="10.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/footnote"
                android:textColor="@color/faint"
                android:textSize="9sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/loading_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_loading"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/sakura" />

        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.06"
            android:text="@string/loading_connect"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
