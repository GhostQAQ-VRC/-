{
  "name": "hoshikuzu-album",
  "private": true,
  "version": "1.5.0",
  "description": "VRchat时间轴纪念相册 — 面向 VRChat 旅人的本地优先时光相册（网页 + Electron 客户端）",
  "author": "VRchat时间轴纪念相册",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "mock:world": "node tools/mock-world-api.mjs",
    "desktop:dev": "node desktop/dev.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis portable",
    "desktop:dist:local": "npm run build && electron-builder --win nsis portable --config.electronDist=./node_modules/electron/dist",
    "desktop:smoke": "npm run build && node desktop/smoke.cjs",
    "desktop:smoke:onboarding": "npm run build && node desktop/smoke.cjs --no-library",
    "desktop:smoke:thumbnails": "npm run build && node desktop/smoke.cjs --thumbnail-setup",
    "desktop:icon": "node desktop/make-icon.cjs && python tools/make_icon.py",
    "test:desktop": "node desktop/run-tests.cjs",
    "library:cli": "node tools/library-cli.cjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "exifr": "^7.1.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.2.7",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "adm-zip": "^0.6.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
